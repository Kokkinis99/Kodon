{
  "name": "kodon",
  "version": "0.4.0",
  "description": "Sonner-style toast notifications for Angular",
  "keywords": [
    "angular",
    "toast",
    "notifications",
    "sonner",
    "snackbar"
  ],
  "author": "George Kokkinis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kokkinis99/kodon.git"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0 || ^22.0.0",
    "@angular/core": "^21.0.0 || ^22.0.0",
    "@lucide/angular": "^1.0.0",
    "ng-primitives": ">=0.131.0 <1.0.0"
  },
  "dependencies": {
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/cdk": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@floating-ui/dom": "^1.7.0",
    "@lucide/angular": "^1.70.0",
    "ng-packagr": "^22.2.6",
    "ng-primitives": "^0.131.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "watch": "ng-packagr -p ng-package.json --watch",
    "demo": "ng serve demo",
    "build:demo": "rm -rf docs && ng build demo --base-href / && mv docs/browser/* docs/ && rmdir docs/browser && rm -f docs/prerendered-routes.json && cp demo/CNAME docs/"
  },
  "sideEffects": false
}
